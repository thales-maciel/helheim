cabal-version: 3.4
name: helheim
version: 0.1.0.0
license: MIT
author: Helheim contributors
maintainer: unknown
build-type: Simple
synopsis: Haskell baseline for Rinha de Backend 2026

common common-options
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -O2

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Helheim.Api
    Helheim.Index
    Helheim.ReferenceBuilder
    Helheim.Types
    Helheim.Vectorize
  build-depends:
    base >= 4.17 && < 4.22,
    aeson >= 2.1,
    binary >= 0.8,
    bytestring >= 0.11,
    http-types >= 0.12,
    text >= 2.0,
    time >= 1.12,
    vector >= 0.13,
    wai >= 3.2,
    warp >= 3.3,
    zlib >= 0.6

executable helheim-api
  import: common-options
  hs-source-dirs: app
  main-is: ApiMain.hs
  ghc-options:
    -threaded
    -rtsopts
  build-depends:
    base,
    helheim

executable helheim-build-index
  import: common-options
  hs-source-dirs: app
  main-is: BuildIndexMain.hs
  ghc-options:
    -threaded
    -rtsopts
  build-depends:
    base,
    helheim

test-suite helheim-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  ghc-options:
    -threaded
    -rtsopts
  build-depends:
    base,
    aeson,
    bytestring,
    helheim,
    text,
    vector
